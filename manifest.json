{
  "manifest_version": 3,
  "name": "Medium → Freedium",
  "version": "2.0",
  "description": "Opens Medium articles on Freedium mirror automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
                    "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Medium → Freedium"
  }
}
